{
  "name": "docmost-sdk",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript client for the Docmost REST API. Supports API token (Bearer) and email/password (cookie) authentication.",
  "keywords": ["docmost", "wiki", "api", "sdk", "client"],
  "license": "MIT",
  "author": "Docmost SDK Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggpo1/docmost-sdk.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/ggpo1/docmost-sdk/tree/main/typescript",
  "bugs": {
    "url": "https://github.com/ggpo1/docmost-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "generate": "python3 scripts/generate_sdk.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^5.0.0",
    "tough-cookie": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
